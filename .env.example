[TEMPLATE]
# Copy to .env and start the server from backend/ (uvicorn loads it automatically via python-dotenv).
ADMIN_KEY=put-a-long-random-string-here

# The UI is served by this same FastAPI app (no more Vite dev server), so CORS_ORIGINS must
# include EVERY origin the UI is served from - /ws/scan checks the browser's Origin header
# against this list and closes 4403 otherwise. Add your LAN/HTTPS origin for a real kiosk.
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000
DATA_DIR=./data

# Recognition: 128-d face_recognition/dlib encodings matched by Euclidean face_distance.
# Set TOLERANCE from scripts/calibrate.py output, not by guessing.
TOLERANCE=0.5
IDENTIFY_MARGIN=0.05
DETECT_SCALE=0.5
ENROLL_JITTERS=5

# Scan speed / liveness. Defaults are tuned for a fast still-face check-in (~2-4 s):
# 4 stable frames per window and no head-turn challenge. Set CHALLENGE_STEPS=2 to re-enable
# the anti-photo/anti-screen liveness check (costs a few seconds of user time).
STABLE_FRAMES=4
CHALLENGE_STEPS=0

# Turn on while tuning gates; shows raw yaw/pitch/blur/etc. in the scanner UI
DEBUG_METRICS=0

# Optional YOLO object guard (pip install -r requirements-optional.txt)
OBJECT_DETECTION=0
